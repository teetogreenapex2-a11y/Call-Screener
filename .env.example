# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number callers dial (E.164, e.g. +19195550123). Used to send you the text summary.
TWILIO_PHONE_NUMBER=
# Your real cell. Legit calls are connected here. Summaries are texted here. Only this phone can text VM ON / VM OFF.
OWNER_PHONE=

# Added for you when you connect the Upstash Redis database in Vercel > Storage (don't type these in):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional
OWNER_NAME=Rick
# Tells Claude who counts as a legit caller. Edit freely.
OWNER_CONTEXT=
# Free push notifications through the ntfy app: pick a long random topic name and subscribe to it in the app.
NTFY_TOPIC=
# Set to 0 to turn off text-message summaries (US SMS from a new Twilio number needs carrier registration).
NOTIFY_SMS=1
# Voicemail setting used until you text VM ON or VM OFF (on or off).
VOICEMAIL_DEFAULT=off
# Seconds your phone rings before voicemail (8 to 60). Keep it shorter than your carrier's voicemail.
RING_SECONDS=18
# 2 = greeting plus one follow-up question. Max questions before Claude must decide.
MAX_ROUNDS=2
CLAUDE_MODEL=claude-haiku-4-5-20251001
TTS_VOICE=Polly.Joanna-Neural
# Password for the ring-through list page (/api/contacts?key=THIS). Use 12+ random characters.
ADMIN_KEY=
# on (default): when you answer a screened call you hear who it is and press 1 to accept or 2 to decline. Set to off to skip.
WHISPER=on
# Android app calling (see README, "Android app"): a Twilio API key and a Push Credential for Firebase.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PUSH_CREDENTIAL_SID=
# Where screened calls ring until you choose in the app: phone, app or both.
RING_MODE=phone

# Limits (optional)
# Screened calls allowed per month for each customer (default 500). 0 = no limit.
CUSTOMER_MONTHLY_CALLS=500
# Same for your own number (default 0 = no limit).
OWNER_MONTHLY_CALLS=0
# Longest a connected call can last, in minutes (default 90).
MAX_CALL_MINUTES=90
